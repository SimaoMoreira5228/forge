[project]
name = "c_example"
version = "0.1.0"
hermetic = "relaxed"

[discovery]
include = [
    ".",
]
exclude = []
use_gitignore = true
max_depth = 10

[build]
cache_dir = "forge-out"

[build.global_env]

[toolchain.gcc]
from = "version"
version = "14.2.0"

[toolchain.clang]
from = "version"
version = "19.1.7"

[profile.debug]
opt_level = 0
debug     = true

[profile.release]
opt_level = 3
debug     = false
lto       = true
defines   = ["NDEBUG=1", "PRODUCTION=1"]

[profile.asan]
inherits   = "debug"
sanitizers = ["address"]

[profile.tsan]
inherits   = "debug"
sanitizers = ["thread"]

[profile.coverage]
inherits = "debug"
coverage = true
