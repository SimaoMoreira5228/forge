[project]
name = "cpp_modules_example"
version = "0.1.0"

[discovery]
include = ["."]

[toolchain.clang]
from = "version"
version = "19.1.7"

[profile.debug]
opt_level = 0
debug     = true

[profile.release]
opt_level = 3
debug     = false
lto       = true

[profile.asan]
inherits   = "debug"
sanitizers = ["address"]

[profile.tsan]
inherits   = "debug"
sanitizers = ["thread"]

[profile.coverage]
inherits = "debug"
coverage = true
