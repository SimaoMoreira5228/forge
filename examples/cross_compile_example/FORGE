local c = require("@prelude/c/c.lua")

-- The host tool (built for the host architecture)
c.binary {
    name = "codegen",
    srcs = { "codegen.c" },
    exec_cfg = "host",  -- Transition to host platform
    targets = {
        linux_x64 = { target = "linux_x64" },
        my_target = { target = "my_target" },
    }
}

-- The generator step (runs the host tool)
-- We use forge.rule to register it directly in the build engine graph.
local host_out_dir = require("@prelude/build_common.lua").get_out_dir("linux_x64", "host")

forge.rule {
    name = "run_codegen",
    command = forge.path.join({host_out_dir, "codegen"}),
    args = { "generated.c" },
    outputs = { "generated.c" },
    dependencies = { "codegen-compile-linux_x64" }
}

-- The target binary (depends on the generated file)
c.binary {
    name = "main",
    srcs = { "main.c", "generated.c" },
    rule_dependencies = { "run_codegen" },
    targets = {
        linux_x64 = { target = "linux_x64" },
        my_target = { target = "my_target", compiler = "gcc", compiler_path="aarch64-linux-gnu-gcc" },
    }
}
