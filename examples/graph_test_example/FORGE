local bash = require("@prelude/bash/bash.lua")

-- Example demonstrating bash.test() for graph-based test discovery.

-- Register a build target
forge.graph.target { name = "linux_x64", triple = "x86_64-unknown-linux-gnu" }

-- A simple "test" that runs an inline shell command.
-- The command checks that basic arithmetic works (100% deterministic).
bash.test {
    name    = "arithmetic_test",
    args    = { "-c", "test $(( 1 + 1 )) -eq 2 && echo 'arithmetic: OK'" },
    timeout = 10,
    size    = "small",
    tags    = { "unit" },
}

-- A second test that verifies string manipulation
bash.test {
    name    = "string_test",
    args    = { "-c", "test 'hello world' = 'hello world' && echo 'strings: OK'" },
    timeout = 10,
    size    = "small",
    tags    = { "unit" },
}

-- A test tagged 'manual' — should be skipped in normal test runs
bash.test {
    name    = "skipped_manual_test",
    args    = { "-c", "echo 'This should never run in CI'" },
    timeout = 10,
    tags    = { "manual" },
}
